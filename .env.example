# 复制为 .env 并 chmod 600。scripts/bq_sync.sh 会自动 source 它，
# 配置文件里用 ${VAR} / ${VAR:-默认值} 引用这些变量。

# ---- 状态库（所有项目共用）----
BQ_SYNC_MYSQL_HOST=127.0.0.1
BQ_SYNC_MYSQL_PORT=3306
BQ_SYNC_MYSQL_USER=root
BQ_SYNC_MYSQL_PASSWORD=
BQ_SYNC_MYSQL_DATABASE=bq_sync

# ---- 失败通知 ----
BQ_SYNC_NOTIFY_ENABLED=false
BQ_SYNC_NOTIFY_URL=

# ---- 各项目的 GCP 配置 ----
# 变量名由 config.yaml 自己决定，下面只是示例。
MEDIACRAWLER_GCP_PROJECT=
MEDIACRAWLER_GCP_CREDENTIALS=/path/to/service-account.json
